# ============================================================
# APP
# ============================================================
APP_NAME=Customized Learning Hub
ENV=development
API_V1_PREFIX=/api/v1

# ============================================================
# DATABASE — MySQL (XAMPP)
# ============================================================
# XAMPP default: user=root, empty password, port 3306.
# If you set a MySQL root password, URL-encode special chars
# (e.g. p@ss -> p%40ss) and update BOTH URLs below.
DATABASE_URL=mysql+aiomysql://root:@127.0.0.1:3306/clh?charset=utf8mb4
DATABASE_URL_SYNC=mysql+pymysql://root:@127.0.0.1:3306/clh?charset=utf8mb4

# ============================================================
# REDIS (sessions + cache + background queue)
# ============================================================
# Requires Memurai (Windows Redis) or tporadowski/redis running
# on port 6379. Verify with: memurai-cli ping
REDIS_URL=redis://localhost:6379/0

# ============================================================
# SESSION / AUTH
# ============================================================
# 604800 seconds = 7 days
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=clh_session
# Set to true in production (requires HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Argon2id password hashing parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# ============================================================
# EMAIL VERIFICATION / PASSWORD RESET TOKEN TTLs
# ============================================================
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# ============================================================
# BUSINESS DEFAULTS
# ============================================================
# These are *fallback* values. The source of truth is the
# system_settings table (admin-editable at runtime).
DEFAULT_SUBSCRIPTION_PRICE_USD=25
DEFAULT_SUBSCRIPTION_DURATION_DAYS=30
DEFAULT_NOTIFICATION_SCHEDULE="[25, 20, 0]"

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS="http://localhost:3000"