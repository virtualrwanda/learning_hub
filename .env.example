@'
APP_NAME="Customized Learning Hub"
ENV=development
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+aiomysql://root:@127.0.0.1:3306/clh?charset=utf8mb4
DATABASE_URL_SYNC=mysql+pymysql://root:@127.0.0.1:3306/clh?charset=utf8mb4

REDIS_URL=redis://localhost:6379/0

SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=clh_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

DEFAULT_SUBSCRIPTION_PRICE_USD=25
DEFAULT_SUBSCRIPTION_DURATION_DAYS=30
DEFAULT_NOTIFICATION_SCHEDULE="[25, 20, 0]"

CORS_ORIGINS="http://localhost:3000"
'@ | Out-File -FilePath .env -Encoding utf8 -Force